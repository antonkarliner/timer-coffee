# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

# Release notes contain non-ASCII text (•, curly quotes). Without a UTF-8 locale
# (e.g. a non-interactive shell with LANG unset) Ruby reads them as US-ASCII
# and every translation fails.
%w[LANG LC_ALL].each { |key| ENV[key] = 'en_US.UTF-8' if ENV[key].to_s.empty? }
Encoding.default_external = Encoding::UTF_8

# Play only shows changelogs/<versionCode>.txt, and translate_gpt_release_notes
# translates the highest-numbered English changelog, logging and skipping any
# locale that fails without failing the lane. Stop unless the English changelog
# matches the version code and every locale has a translation at least as new.
def ensure_release_notes_translated!
  metadata = File.expand_path('metadata/android')
  master_dir = File.join(metadata, 'en-US', 'changelogs')
  master_name = Dir.children(master_dir).grep(/\A\d+\.txt\z/).max_by(&:to_i)
  expected = "#{get_version_code}.txt"
  unless master_name == expected
    UI.user_error!("Newest en-US changelog is #{master_name.inspect}, but the version code needs #{expected}. Not uploading.")
  end

  master = File.join(master_dir, master_name)
  stale = Dir.children(metadata).sort.reject do |locale|
    next true if locale == 'en-US' || !File.directory?(File.join(metadata, locale))

    file = File.join(metadata, locale, 'changelogs', master_name)
    File.size?(file) && File.mtime(file) >= File.mtime(master)
  end
  UI.user_error!("Changelog #{master_name} not translated for: #{stale.join(', ')}. Not uploading.") unless stale.empty?
  UI.success("Changelog #{master_name} is translated for every locale")
end

# Helper method to get version code from pubspec.yaml
def get_version_code
  require 'yaml'

  # Navigate up to the project root from android/fastlane directory
  project_root = Dir.pwd.split("/android").first
  pubspec_path = File.join(project_root, 'pubspec.yaml')
  pubspec = YAML.load_file(pubspec_path)
  version_string = pubspec['version']
  version_code = version_string.split('+').last
  version_code
end

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  
    # sh "your_script.sh"
    # You can also use other beta testing services here
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    translate_gpt_release_notes(
      master_locale: 'en-US',
      platform: 'android',
      android_length_retries: 2,
      jev_check: true,
      context: 'Timer.Coffee is a coffee brew timer app, please pay special attention to correct usage of coffee-related terms. Do not include the symbols count or any warnings/observations in your response.',
      model_name: 'gpt-5.6-terra',
      temperature: 1.0,
      service_tier: "flex",
      glossary_dir: '../lib/l10n',
      # other necessary parameters...
    )
    ensure_release_notes_translated!
    gradle(
      task: "bundle",
      build_type: "Release"
    )
    upload_to_play_store(
      version_code: get_version_code,
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_screenshots: true,
      skip_upload_images: true,
      skip_upload_metadata: false
    )
  end

  desc "Check the changelog matches the version code and every locale has it"
  lane :check_translations do
    ensure_release_notes_translated!
  end

  lane :translate_release_notes do
    translate_gpt_release_notes(
      master_locale: 'en-US',
      platform: 'android',
      context: 'Timer.Coffee is a coffee brew timer app, please pay special attention to correct usage of coffee-related terms.',
      glossary_dir: '../lib/l10n',
      # other necessary parameters...
    )
  end
end
